---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCards from '../components/ServiceCards.astro';
import { getServices, getSite, phoneHref } from '../lib/content';

const site = getSite();
const services = getServices();
---

<BaseLayout
  title={`Services | ${site.shopName}`}
  description="Tire sales and changes, oil changes, brakes, air bags, inspections, light body work, and light repairs for semis and commercial trucks in Columbus, OH."
>
  <header class="page-hero">
    <div class="container">
      <p class="eyebrow" style="color: #f0c48a;">Services</p>
      <h1>Work that keeps you on the road</h1>
      <p>{services.intro}</p>
      <div class="cta-row" style="margin-top: 1.25rem;">
        <a class="btn btn-primary" href={phoneHref(site.phone)}>Call {site.phone}</a>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <ServiceCards items={services.items} phone={site.phone} />
      <p style="margin-top: 2rem; color: var(--steel);">
        Don’t see what you need? Call {site.phone} — if it’s a light repair we can handle, we’ll say so.
      </p>
    </div>
  </section>
</BaseLayout>
